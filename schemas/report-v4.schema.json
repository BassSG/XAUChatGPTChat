{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xau-desk:report-v4",
  "title": "V4 additive report envelope; semantic validation is src/desk-v4.js plus report-accuracy.js",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotAt",
    "status",
    "desk",
    "headline",
    "summary",
    "bias",
    "entryZone",
    "trigger",
    "invalidation",
    "stop",
    "targets",
    "riskReward",
    "newsRisk",
    "body",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "WAIT",
        "WATCH BUY",
        "WATCH SELL"
      ]
    },
    "testOnly": {
      "type": "boolean",
      "description": "true is rejected by all publication boundaries"
    },
    "desk": {
      "type": "object",
      "required": [
        "policyId",
        "hierarchy",
        "baseline",
        "tacticalState",
        "xauSummary",
        "dailySR",
        "amm",
        "phase",
        "setup",
        "trigger",
        "waitZones",
        "noTradeZones",
        "invalidation",
        "dxy",
        "spdr",
        "news",
        "rebaseline",
        "entryIdea",
        "conclusion"
      ],
      "properties": {
        "policyId": {
          "type": "string"
        },
        "hierarchy": {
          "const": [
            "XAU_HTF",
            "DAILY_SR",
            "AMM",
            "M15_SETUP",
            "M5_TRIGGER",
            "DXY_FILTER"
          ]
        },
        "baseline": {
          "type": "object",
          "required": [
            "id",
            "status",
            "bias",
            "invalidation",
            "refreshReason"
          ],
          "properties": {
            "status": {
              "enum": [
                "ACTIVE",
                "SUSPENDED",
                "UNAVAILABLE"
              ]
            },
            "mode": {
              "enum": [
                "INITIAL",
                "REFRESH",
                "CARRY_FORWARD"
              ]
            },
            "frames": {
              "type": "object",
              "required": [
                "W1",
                "D1",
                "H4",
                "H1"
              ]
            }
          }
        },
        "tacticalState": {
          "enum": [
            "ACTIVE",
            "SUSPENDED"
          ]
        },
        "dailySR": {
          "type": "object",
          "required": [
            "role",
            "summary",
            "levels"
          ],
          "properties": {
            "role": {
              "const": "LOCATION_MAP"
            },
            "levels": {
              "type": "array"
            }
          }
        },
        "amm": {
          "type": "object",
          "required": [
            "role",
            "summary",
            "zones"
          ],
          "properties": {
            "role": {
              "const": "SCENARIO_REFINER"
            },
            "zones": {
              "type": "array"
            },
            "source": {
              "type": "object",
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "UNAVAILABLE",
                    "OBSERVED_OUTPUT",
                    "FORMULA_VERIFIED"
                  ]
                }
              }
            }
          }
        },
        "phase": {
          "type": "object",
          "required": [
            "name",
            "location",
            "reason"
          ],
          "properties": {
            "name": {
              "enum": [
                "TREND_IMPULSE",
                "PULLBACK",
                "CONSOLIDATION",
                "BREAKOUT",
                "RETEST",
                "TRANSITION",
                "REVERSAL_CANDIDATE",
                "UNAVAILABLE"
              ]
            }
          }
        },
        "setup": {
          "type": "object",
          "required": [
            "timeframe",
            "side",
            "status",
            "priceLocation",
            "opposingLiquidity",
            "reason"
          ],
          "properties": {
            "timeframe": {
              "const": "M15"
            }
          }
        },
        "trigger": {
          "type": "object",
          "required": [
            "timeframe",
            "state",
            "condition"
          ],
          "properties": {
            "timeframe": {
              "const": "M5"
            }
          }
        },
        "waitZones": {
          "type": "array"
        },
        "noTradeZones": {
          "type": "array"
        },
        "invalidation": {
          "type": "object",
          "required": [
            "triggerFailure",
            "tactical",
            "structural",
            "actualStop",
            "rebaseline"
          ]
        },
        "dxy": {
          "type": "object",
          "required": [
            "role",
            "state",
            "structure",
            "reason"
          ],
          "properties": {
            "role": {
              "const": "CONFIRMATION_FILTER"
            },
            "state": {
              "enum": [
                "CONFIRM",
                "NEUTRAL",
                "CONTRADICT",
                "UNAVAILABLE"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "timeframe",
                  "direction",
                  "price",
                  "effect",
                  "reason"
                ],
                "properties": {
                  "timeframe": {
                    "enum": [
                      "H1",
                      "H4",
                      "D1",
                      "M15"
                    ]
                  },
                  "direction": {
                    "enum": [
                      "ABOVE",
                      "BELOW"
                    ]
                  },
                  "price": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "effect": {
                    "enum": [
                      "CONFIRM",
                      "NEUTRAL",
                      "CONTRADICT"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "spdr": {
          "type": "object",
          "required": [
            "role",
            "summary",
            "direction",
            "flowBias"
          ],
          "properties": {
            "role": {
              "const": "MEDIUM_TERM_FLOW"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "dataDate",
                  "holdings",
                  "checkedAt",
                  "sourceUrl"
                ],
                "properties": {
                  "dataDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "holdings": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            },
            "flowAssessment": {
              "type": "object",
              "required": [
                "state",
                "direction",
                "flowBias",
                "netChange",
                "observations",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "AVAILABLE",
                    "PARTIAL"
                  ]
                },
                "direction": {
                  "enum": [
                    "UP",
                    "DOWN",
                    "FLAT",
                    "UNKNOWN"
                  ]
                },
                "flowBias": {
                  "enum": [
                    "INFLOW",
                    "OUTFLOW",
                    "MIXED",
                    "UNKNOWN"
                  ]
                },
                "netChange": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "observations": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "news": {
          "type": "object",
          "required": [
            "role",
            "regime",
            "policyId"
          ],
          "properties": {
            "role": {
              "const": "REGIME_EVENT_RISK"
            },
            "context": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "fact",
                  "interpretation",
                  "goldMechanism",
                  "monitor",
                  "checkedAt",
                  "sourceUrl"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "EVENT",
                      "YIELD",
                      "HEADLINE"
                    ]
                  },
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interpretation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "goldMechanism": {
                    "type": "string",
                    "minLength": 1
                  },
                  "monitor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "dataDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "eventTitle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eventAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "EVENT"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "eventTitle",
                        "eventAt"
                      ]
                    },
                    "else": {
                      "required": [
                        "dataDate"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "rebaseline": {
          "type": "object",
          "required": [
            "state",
            "signals"
          ],
          "properties": {
            "state": {
              "enum": [
                "STABLE",
                "REQUIRED"
              ]
            },
            "signals": {
              "type": "array"
            }
          }
        },
        "risk": {
          "type": "object",
          "description": "Required for WATCH: STRUCTURE_FIRST, stopEvidence, targetEvidence"
        },
        "entryIdea": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "xauSummary": {
          "type": "string",
          "minLength": 1
        },
        "architectureVersion": {
          "enum": [
            "4.2",
            "4.3"
          ]
        },
        "locationMatrix": {
          "type": "object",
          "required": [
            "state",
            "reason",
            "currentPrice",
            "quoteAt",
            "aboveCandidates",
            "atCandidates",
            "belowCandidates",
            "continuationLevels",
            "criticalLevels"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE"
              ]
            },
            "currentPrice": {
              "type": [
                "number",
                "null"
              ]
            },
            "aboveCandidates": {
              "type": "array"
            },
            "atCandidates": {
              "type": "array"
            },
            "belowCandidates": {
              "type": "array"
            },
            "continuationLevels": {
              "type": "array"
            },
            "criticalLevels": {
              "type": "array"
            }
          }
        },
        "scenarioSelection": {
          "type": "object",
          "required": [
            "mode",
            "reason"
          ],
          "properties": {
            "mode": {
              "enum": [
                "AUTO",
                "ANALYST"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "rejectedLocationReason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "activeScenarioRole": {
          "enum": [
            "PRIMARY",
            "ALTERNATIVE"
          ]
        },
        "toolkit": {
          "type": "object",
          "properties": {
            "observations": {
              "type": "array"
            }
          }
        },
        "opportunityInputs": {
          "type": "object",
          "properties": {
            "continuationScenarios": {
              "type": "array"
            }
          }
        },
        "indicatorVerification": {
          "type": "object",
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "UNAVAILABLE",
                "NAME_ONLY",
                "INPUTS_VERIFIED",
                "EXACT_SOURCE_VERIFIED",
                "SOURCE_MISMATCH"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "object",
              "required": [
                "combo_kLength",
                "combo_kSmooth",
                "combo_dLength",
                "combo_rsiLength",
                "i_htfFilter",
                "i_costTicks",
                "lp_view",
                "lp_tf1",
                "lp_tf2",
                "lp_tf3",
                "s_tfMode",
                "z_refresh",
                "z_swingLen",
                "z_breakMode"
              ],
              "properties": {
                "combo_kLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                "combo_kSmooth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "combo_dLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "combo_rsiLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                "i_htfFilter": {
                  "type": "boolean"
                },
                "i_costTicks": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "lp_view": {
                  "enum": [
                    "Limit Planner",
                    "Confirmation",
                    "Both"
                  ]
                },
                "lp_tf1": {
                  "type": "string"
                },
                "lp_tf2": {
                  "type": "string"
                },
                "lp_tf3": {
                  "type": "string"
                },
                "s_tfMode": {
                  "enum": [
                    "Intraday standard",
                    "Adaptive",
                    "Legacy fixed"
                  ]
                },
                "z_refresh": {
                  "enum": [
                    "Closed bars",
                    "Live preview"
                  ]
                },
                "z_swingLen": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 30
                },
                "z_breakMode": {
                  "enum": [
                    "Close",
                    "Wick"
                  ]
                }
              }
            },
            "verifiedAt": {
              "type": "string",
              "format": "date-time"
            },
            "chartSourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "profileId": {
              "const": "EBW_V10_4_4_FIX1"
            },
            "referenceFileSha256": {
              "const": "9449f87a12d8414f6f5ea751cc1e18977c4a1a2dc596f3082941364e9702fa80"
            },
            "referenceCanonicalSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "symbol": {
              "const": "PEPPERSTONE:XAUUSD"
            },
            "chartUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "UNAVAILABLE"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "profileId",
                  "referenceFileSha256",
                  "symbol",
                  "chartUrl",
                  "verifiedAt"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "INPUTS_VERIFIED",
                      "EXACT_SOURCE_VERIFIED"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "inputs"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "EXACT_SOURCE_VERIFIED"
                  }
                }
              },
              "then": {
                "required": [
                  "chartSourceSha256",
                  "referenceCanonicalSha256"
                ],
                "properties": {
                  "chartSourceSha256": {
                    "const": "dca2f6ae1a6314bb5e152e6bcd689732cf21b8fec27cab2383f8c29487b4ffc4"
                  },
                  "referenceCanonicalSha256": {
                    "const": "dca2f6ae1a6314bb5e152e6bcd689732cf21b8fec27cab2383f8c29487b4ffc4"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "UNAVAILABLE"
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "inputs"
                      ]
                    },
                    {
                      "required": [
                        "chartSourceSha256"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "zoneEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "candidateId",
              "items",
              "reason"
            ]
          }
        },
        "planning": {
          "type": "object",
          "required": [
            "rows",
            "note"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "side",
                  "zone",
                  "state",
                  "stopAnchor",
                  "targetCandidates",
                  "entry",
                  "actualStop",
                  "targets",
                  "netR",
                  "invalidation"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "PRIMARY",
                      "ALTERNATIVE"
                    ]
                  },
                  "side": {
                    "enum": [
                      "BUY",
                      "SELL"
                    ]
                  },
                  "setupType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "zone": {
                    "type": "object",
                    "required": [
                      "low",
                      "high"
                    ],
                    "properties": {
                      "low": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "high": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  },
                  "state": {
                    "enum": [
                      "WATCH_LOCATION",
                      "CONDITIONAL_EXECUTION"
                    ]
                  },
                  "stopAnchor": {
                    "type": "object",
                    "required": [
                      "state",
                      "price",
                      "evidence",
                      "reason"
                    ],
                    "properties": {
                      "state": {
                        "enum": [
                          "VERIFIED_STRUCTURAL_ANCHOR",
                          "EXTREMUM_CANDIDATE",
                          "UNAVAILABLE"
                        ]
                      },
                      "price": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "evidence": {
                        "type": "array"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "targetCandidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "price",
                        "evidence",
                        "levelId"
                      ],
                      "properties": {
                        "price": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "evidence": {
                          "type": "array"
                        },
                        "levelId": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "entry": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "actualStop": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "targets": {
                    "type": "array"
                  },
                  "netR": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "invalidation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "practical": {
          "type": "object",
          "required": [
            "bias",
            "phase",
            "location",
            "primary",
            "confirmation",
            "alternative",
            "activeRole",
            "activePlan",
            "activeConfirmation",
            "avoid",
            "cancellation",
            "changed",
            "next",
            "asOf"
          ],
          "properties": {
            "bias": {
              "type": "string",
              "minLength": 1
            },
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            },
            "primary": {
              "type": "string",
              "minLength": 1
            },
            "confirmation": {
              "type": "string",
              "minLength": 1
            },
            "alternative": {
              "type": "string",
              "minLength": 1
            },
            "activeRole": {
              "enum": [
                "PRIMARY",
                "ALTERNATIVE"
              ]
            },
            "activePlan": {
              "type": "string",
              "minLength": 1
            },
            "activeConfirmation": {
              "type": "string",
              "minLength": 1
            },
            "avoid": {
              "type": "string",
              "minLength": 1
            },
            "cancellation": {
              "type": "string",
              "minLength": 1
            },
            "changed": {
              "type": "string",
              "minLength": 1
            },
            "next": {
              "type": "string",
              "minLength": 1
            },
            "asOf": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "reviewDefinition": {
          "type": "object",
          "required": [
            "m5",
            "invalidation"
          ],
          "properties": {
            "m5": {
              "type": "object",
              "required": [
                "confirmation",
                "price",
                "zone",
                "reason"
              ],
              "properties": {
                "confirmation": {
                  "enum": [
                    "TOUCH_THEN_DIRECTIONAL_CLOSE",
                    "RETEST_THEN_CLOSE",
                    "STRUCTURE_BREAK"
                  ]
                },
                "price": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "zone": {
                  "type": "object",
                  "required": [
                    "low",
                    "high"
                  ],
                  "properties": {
                    "low": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "high": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "levelEvidence": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "confirmation": {
                        "const": "STRUCTURE_BREAK"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "levelEvidence"
                    ]
                  }
                }
              ]
            },
            "invalidation": {
              "type": "object",
              "required": [
                "timeframe",
                "direction",
                "price"
              ],
              "properties": {
                "timeframe": {
                  "enum": [
                    "M5",
                    "M15",
